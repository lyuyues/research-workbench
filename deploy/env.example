# Environment for the Research Workbench service (systemd EnvironmentFile syntax: KEY=value, no quotes).
# Copy to ~/.config/research-workbench/env and chmod 600.

# Your research folder (the agent's working directory) and the undo journal (keep it OUTSIDE the folder).
RP_RESEARCH_ROOT=/home/me/Research
RP_GIT_DIR=/home/me/.local/state/research-workbench/journal.git
# Built frontend (frontend/dist). Leave unset to serve the API only.
RP_STATIC_DIR=/home/me/research-workbench/frontend/dist
# claude binary and per-run agent timeout (seconds).
RP_CLAUDE_BIN=claude
RP_AGENT_TIMEOUT=1800
# Your time zone for scheduled jobs and the timeline.
RP_TZ=UTC                       # your time zone, e.g. Europe/Berlin

# Authentication. On a server keep RP_REQUIRE_ACCESS=1: every request must carry a valid Cloudflare Access JWT.
RP_REQUIRE_ACCESS=1
RP_ACCESS_TEAM=
RP_ACCESS_AUD=
RP_ACCESS_EMAIL=you@example.com
# Exact Origin accepted on the agent WebSocket.
RP_ALLOWED_ORIGIN=https://research.example.com

# Claude subscription token for the agent: the output of `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
